@@ -0,0 +1,21 @@
+package api
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestFLVTimingHandlerLoopbackOnly(t *testing.T) {
+	for _, test := range []struct {
+		address, method string
+		code            int
+	}{{"127.0.0.1:123", "GET", 200}, {"[::1]:123", "GET", 200}, {"192.168.1.2:123", "GET", 403}, {"127.0.0.1:123", "POST", 405}} {
+		r := httptest.NewRequest(test.method, "/api/diagnostics/flv-timing", nil)
+		r.RemoteAddr = test.address
+		w := httptest.NewRecorder()
+		flvTimingHandler(w, r)
+		if w.Code != test.code {
+			t.Fatalf("%+v: %d", test, w.Code)
+		}
+	}
+}
