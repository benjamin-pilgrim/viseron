new file mode 100644
index 0000000..65241a7
--- /dev/null
+++ b/internal/api/flv_timing.go
@@ -0,0 +1,26 @@
+package api
+
+import (
+	"encoding/json"
+	"github.com/AlexxIT/go2rtc/pkg/flv"
+	"net"
+	"net/http"
+	"time"
+)
+
+var flvTimingInstance = time.Now().UnixNano()
+
+func flvTimingHandler(w http.ResponseWriter, r *http.Request) {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || !net.ParseIP(host).IsLoopback() {
+		http.Error(w, "loopback only", http.StatusForbidden)
+		return
+	}
+	if r.Method != http.MethodGet {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	_ = json.NewEncoder(w).Encode(map[string]any{"instance": flvTimingInstance, "records": flv.TimingSnapshot()})
+}
