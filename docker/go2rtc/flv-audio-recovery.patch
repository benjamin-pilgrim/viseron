+
+// renegotiate keeps the camera reader and queued packets alive while consumers
+// reconnect with a new SDP. It never dials another camera connection.
+func (p *Producer) renegotiate(next core.Producer, workerID int, grace time.Duration) {
+	p.mu.Lock()
+	if p.workerID != workerID {
+		p.mu.Unlock()
+		_ = next.Stop()
+		return
+	}
+	receivers := p.receivers
+	p.conn = next
+	p.receivers, p.senders = nil, nil
+	p.state = stateRenegotiating
+	p.mediaChangePending = true
+	p.workerID++
+	generation := p.workerID
+	callback := p.onMediaChanged
+	p.mu.Unlock()
+
+	time.AfterFunc(grace, func() {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		if p.workerID == generation && p.mediaChangePending {
+			p.mediaChangePending = false
+			p.stopLocked()
+		}
+	})
+
+	// Stop sessions outside the producer mutex: their cleanup can call p.stop.
+	if callback != nil {
+		callback()
+	}
+	for _, receiver := range receivers {
+		receiver.Close()
+	}
+	p.mu.Lock()
+	if p.workerID == generation && p.state == stateRenegotiating {
+		p.state = stateMedias
+	}
+	p.mu.Unlock()
+}
