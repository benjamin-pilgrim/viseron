+package core
+
+// MediaChangedError hands a live source to a replacement producer when its
+// discovered track set changes. The caller must not close the old transport:
+// ReplacementProducer owns it, including any unread media.
+type MediaChangedError struct {
+	Replacement Producer
+}
+
+func (e *MediaChangedError) Error() string {
+	return "source media changed; renegotiate consumer tracks"
+}
+func (e *MediaChangedError) ReplacementProducer() Producer { return e.Replacement }
