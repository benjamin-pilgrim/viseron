diff --git a/internal/streams/recoverytest/recovery_test.go b/internal/streams/recoverytest/recovery_test.go
new file mode 100644
--- /dev/null
+++ b/internal/streams/recoverytest/recovery_test.go
@@ -0,0 +1,159 @@
+package recoverytest
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/internal/streams"
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+type source struct {
+	core.Connection
+	release chan struct{}
+	closed  chan struct{}
+	once    sync.Once
+	next    core.Producer
+}
+
+func (s *source) Start() error {
+	if s.next != nil {
+		<-s.release
+		return &core.MediaChangedError{Replacement: s.next}
+	}
+	<-s.closed
+	return nil
+}
+func (s *source) Stop() error { s.once.Do(func() { close(s.closed) }); return nil }
+func newSource(audio bool) *source {
+	medias := []*core.Media{{Kind: core.KindVideo, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecH264, ClockRate: 90000}}}}
+	if audio {
+		medias = append(medias, &core.Media{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{{Name: core.CodecAAC, ClockRate: 16000}}})
+	}
+	return &source{Connection: core.Connection{Medias: medias}, closed: make(chan struct{})}
+}
+
+type consumer struct {
+	core.Connection
+	closed chan struct{}
+	once   sync.Once
+}
+
+func newConsumer() *consumer {
+	return &consumer{Connection: core.Connection{Medias: []*core.Media{{Kind: core.KindVideo, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecH264}}}, {Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{{Name: core.CodecAAC}}}}}, closed: make(chan struct{})}
+}
+func (c *consumer) AddTrack(media *core.Media, codec *core.Codec, receiver *core.Receiver) error {
+	c.Senders = append(c.Senders, core.NewSender(media, codec).WithParent(receiver))
+	return nil
+}
+func (c *consumer) Stop() error {
+	c.once.Do(func() { _ = c.Connection.Stop(); close(c.closed) })
+	return nil
+}
+func wait(t *testing.T, ch <-chan struct{}, timeout time.Duration) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(timeout):
+		t.Fatal("timed out")
+	}
+}
+
+func recoveryStream(t *testing.T) (*streams.Stream, *source, *source, *atomic.Int32) {
+	t.Helper()
+	next := newSource(true)
+	first := newSource(false)
+	first.next = next
+	first.release = make(chan struct{})
+	dials := new(atomic.Int32)
+	scheme := "recover" + t.Name()
+	streams.HandleFunc(scheme, func(string) (core.Producer, error) { dials.Add(1); return first, nil })
+	return streams.NewStream(scheme + ":synthetic"), first, next, dials
+}
+func TestRecoveryReusesSourceAfterConsumerCleanup(t *testing.T) {
+	stream, first, next, dials := recoveryStream(t)
+	old := newConsumer()
+	if err := stream.AddConsumer(old); err != nil {
+		t.Fatal(err)
+	}
+	cleanup := make(chan struct{})
+	go func() { <-old.closed; stream.RemoveConsumer(old); close(cleanup) }()
+	close(first.release)
+	wait(t, cleanup, time.Second)
+	select {
+	case <-next.closed:
+		t.Fatal("cleanup closed handed-off source")
+	default:
+	}
+	fresh := newConsumer()
+	deadline := time.Now().Add(time.Second)
+	for {
+		err := stream.AddConsumer(fresh)
+		if err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal(err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if len(fresh.Senders) != 2 {
+		t.Fatalf("new consumer did not negotiate both tracks: %d", len(fresh.Senders))
+	}
+	if dials.Load() != 1 {
+		t.Fatalf("camera redialed: %d", dials.Load())
+	}
+	select {
+	case <-first.closed:
+		t.Fatal("old producer closed shared transport")
+	default:
+	}
+	stream.RemoveConsumer(fresh)
+	wait(t, next.closed, time.Second)
+}
+func TestRecoveryClosesAbandonedSource(t *testing.T) {
+	stream, first, next, dials := recoveryStream(t)
+	old := newConsumer()
+	if err := stream.AddConsumer(old); err != nil {
+		t.Fatal(err)
+	}
+	go func() { <-old.closed; stream.RemoveConsumer(old) }()
+	close(first.release)
+	wait(t, next.closed, 35*time.Second)
+	if dials.Load() != 1 {
+		t.Fatal("unexpected camera connection")
+	}
+}
+func TestVideoOnlySourceDoesNotRefreshConsumer(t *testing.T) {
+	only := newSource(false)
+	scheme := "videoonly"
+	streams.HandleFunc(scheme, func(string) (core.Producer, error) { return only, nil })
+	stream := streams.NewStream(scheme + ":synthetic")
+	c := newConsumer()
+	if err := stream.AddConsumer(c); err != nil {
+		t.Fatal(err)
+	}
+	if len(c.Senders) != 1 {
+		t.Fatal("wrong video-only track count")
+	}
+	select {
+	case <-c.closed:
+		t.Fatal("video-only consumer was refreshed")
+	case <-time.After(20 * time.Millisecond):
+	}
+	stream.RemoveConsumer(c)
+	wait(t, only.closed, time.Second)
+}
+
+func TestStoppedRecoveryReleasesReplacement(t *testing.T) {
+	stream, first, next, _ := recoveryStream(t)
+	old := newConsumer()
+	if err := stream.AddConsumer(old); err != nil {
+		t.Fatal(err)
+	}
+	stream.RemoveConsumer(old)
+	close(first.release)
+	wait(t, next.closed, time.Second)
+}
