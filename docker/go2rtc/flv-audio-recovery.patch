diff --git a/pkg/flv/late_audio_test.go b/pkg/flv/late_audio_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/flv/late_audio_test.go
@@ -0,0 +1,148 @@
+package flv
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+type trackedFLVReader struct {
+	*bytes.Reader
+	closed bool
+}
+
+func (r *trackedFLVReader) Close() error { r.closed = true; return nil }
+
+func lateAudioFixture(audio bool) []byte {
+	data := []byte{'F', 'L', 'V', 1, 0, 0, 0, 0, 9}
+	data = append(data, sourceTimestampTag(TagData, 0, []byte("onMetaData width"))...)
+	data = append(data, sourceTimestampTag(TagVideo, 0, []byte{0x17, 0, 0, 0, 0, 1, 0x42, 0, 0x1e, 0xff, 0xe1, 0, 2, 0x67, 0x42, 1, 0, 2, 0x68, 0xce})...)
+	data = append(data, sourceTimestampTag(TagVideo, 1, []byte{0x17, 1, 0, 0, 0, 0, 0, 0, 2, 0x65, 0x88})...)
+	if audio {
+		data = append(data, sourceTimestampTag(TagAudio, 2, []byte{0xaf, 0, 0x14, 0x08})...)
+		data = append(data, sourceTimestampTag(TagAudio, 3, []byte{0xaf, 1, 0x11, 0x22})...)
+	}
+	return data
+}
+
+func TestFLVLateAudioRetainsSourceForRenegotiation(t *testing.T) {
+	rd := &trackedFLVReader{Reader: bytes.NewReader(lateAudioFixture(true))}
+	p, err := Open(rd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Medias) != 1 {
+		t.Fatalf("expected initial video-only discovery: %+v", p.Medias)
+	}
+	video, err := p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	frames := 0
+	video.Input = func(*core.Packet) { frames++ }
+	p.EnableMediaChangeHandoff()
+	err = p.Start()
+	var changed interface {
+		error
+		ReplacementProducer() core.Producer
+	}
+	if !errors.As(err, &changed) {
+		t.Fatalf("late AAC must request renegotiation, got %v (video frames=%d)", err, frames)
+	}
+	if frames == 0 {
+		t.Fatal("video was not delivered before audio arrived")
+	}
+	if rd.closed {
+		t.Fatal("camera connection closed during handoff")
+	}
+	next := changed.ReplacementProducer()
+	var audio *core.Receiver
+	for _, m := range next.GetMedias() {
+		if m.Kind == core.KindAudio {
+			audio, err = next.GetTrack(m, m.Codecs[0])
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if audio == nil || !audio.Codec.RawTimestamp || audio.Codec.ClockRate != 16000 {
+		t.Fatalf("missing source-clock AAC: %+v", audio)
+	}
+	packets := 0
+	audio.Input = func(*core.Packet) { packets++ }
+	if err = next.Start(); err != io.EOF {
+		t.Fatal(err)
+	}
+	if packets != 1 {
+		t.Fatalf("handoff lost queued audio: %d", packets)
+	}
+	if err = next.Stop(); err != nil || !rd.closed {
+		t.Fatal("replacement did not release camera connection")
+	}
+}
+
+func TestFLVVideoOnlyDoesNotRequestRenegotiation(t *testing.T) {
+	p, err := Open(bytes.NewReader(lateAudioFixture(false)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0]); err != nil {
+		t.Fatal(err)
+	}
+	if err = p.Start(); err != io.EOF {
+		t.Fatalf("video-only source should stay video-only: %v", err)
+	}
+}
+
+func TestFLVUnrequestedAudioDoesNotRefreshVideoConsumer(t *testing.T) {
+	fixture := lateAudioFixture(true)
+	// Without metadata, probing reaches both sequence headers. The consumer only
+	// requests video even though the source correctly advertises audio.
+	fixture = append([]byte{'F', 'L', 'V', 1, 0, 0, 0, 0, 9}, fixture[9+len(sourceTimestampTag(TagData, 0, []byte("onMetaData width"))):]...)
+	p, err := Open(bytes.NewReader(fixture))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Medias) != 2 {
+		t.Fatal("fixture did not discover audio")
+	}
+	if _, err = p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0]); err != nil {
+		t.Fatal(err)
+	}
+	p.EnableMediaChangeHandoff()
+	if err = p.Start(); err != io.EOF {
+		t.Fatalf("intentionally unrequested audio refreshed consumer: %v", err)
+	}
+}
+
+func TestFLVIncompleteLateAudioDoesNotInterruptVideo(t *testing.T) {
+	data := lateAudioFixture(false)
+	data = append(data, sourceTimestampTag(TagAudio, 2, []byte{0xaf, 0})...)
+	p, err := Open(bytes.NewReader(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0]); err != nil {
+		t.Fatal(err)
+	}
+	p.EnableMediaChangeHandoff()
+	if err = p.Start(); err != io.EOF {
+		t.Fatalf("bad optional audio interrupted video: %v", err)
+	}
+}
+
+func TestFLVUnmanagedSourceKeepsStartContract(t *testing.T) {
+	p, err := Open(bytes.NewReader(lateAudioFixture(true)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = p.GetTrack(p.Medias[0], p.Medias[0].Codecs[0]); err != nil {
+		t.Fatal(err)
+	}
+	if err = p.Start(); err != io.EOF {
+		t.Fatalf("direct FLV caller unexpectedly needs a handoff manager: %v", err)
+	}
+}
